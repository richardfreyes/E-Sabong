# PRODUCTION environment of the Contabo layout (one Cloud VPS 6: 6 vCPU, 12 GB RAM, shared with
# UAT). Copy to /opt/esabong/prod/.env on the server (mode 600, owner = deploy user) and replace
# every CHANGE_ME. Runbook: docs/deployment-contabo.md. Never commit the real .env.
#
# Every secret must be generated separately and must differ from UAT's
# (infrastructure/scripts/check-env-isolation.py enforces it).
#
# Generate each secret separately:   openssl rand -base64 48 | tr -d '\n/+='
# Generate VIDEO_CREDENTIALS_KEY:     docker run --rm python:3.12-slim python -c \
#   "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Environment identity (do not change) ---------------------------------------------------
# Selects the Compose project esabong-prod (containers, volumes, networks) and the gateway
# network esabong-prod-gateway. The checkout directory must be named "prod".
ESB_STACK=prod
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.contabo.yml
COMPOSE_PROFILES=streaming

# --- Runtime -------------------------------------------------------------------------------
ENVIRONMENT=production
APP_NAME="E-Sabong"
LOG_LEVEL=INFO
DEPLOYMENT_MODE=shared
DEDICATED_TENANT_SLUG=
# https://swcmain183.live/ serves ROOT_TENANT_SLUG (player at /, admin at /admin/); the owner
# console is at /owner/ on the same host. Other tenants: <slug>.swcmain183.live (wildcard DNS)
# or verified custom domains. Create the tenant in the owner console first, then set the slug.
BASE_DOMAIN=swcmain183.live
PLATFORM_HOST=swcmain183.live
ROOT_TENANT_SLUG=CHANGE_ME_tenant_slug
PUBLIC_SCHEME=https
ALLOW_TENANT_HEADER=false
COOKIE_SECURE=true
API_DOCS_ENABLED=
# Never true in production (deploy.sh and check-env-isolation.py refuse it).
SYNTHETIC_DATA_ENABLED=false

# --- PostgreSQL (internal network only; no host port in production) ------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_NAME=esabong
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
DB_EXTRA_DATABASES=

# --- Redis (internal network only) --------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_CONNECTIONS=100
REDIS_PUBSUB_MAX_CONNECTIONS=1024
REDIS_POOL_TIMEOUT_SECONDS=5

# --- Auth -----------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_CHARACTERS

# --- Licensing (only for a control plane that sells dedicated licenses) --------------------
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
LICENSE_TOKEN=
LICENSE_HEARTBEAT_URL=

# --- Mail (required in production) ---------------------------------------------------------
SMTP_HOST=CHANGE_ME.smtp-provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
MAIL_FROM=no-reply@CHANGE_ME.example-domain.com

# --- Billing ---------------------------------------------------------------------------------
DEFAULT_CURRENCY=PHP
INVOICE_TAX_RATE_BPS=0

# --- Edge ------------------------------------------------------------------------------------
# TLS terminates at the shared gateway (infrastructure/gateway/.env). This stack's Caddy is a
# plain-HTTP origin without host ports; the production overlay still requires these two values.
ACME_EMAIL=CHANGE_ME@example-domain.com
CADDY_TLS_MODE=acme

# --- External video provider (optional, unchanged feature) -----------------------------------
VIDEO_CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
VIDEO_API_HOSTS=[]
VIDEO_MEDIA_HOSTS=[]
VIDEO_BROWSER_ORIGINS=

# --- Live streaming (MediaMTX) ----------------------------------------------------------------
MEDIAMTX_API_PASSWORD=CHANGE_ME_RANDOM_24_PLUS
# The VPS's public IPv4 address (Contabo assigns it directly to eth0).
STREAM_PUBLIC_HOSTS=46.250.249.61
# Shown to operators for OBS RTMP (the API appends /live). Leave empty when using WHIP only.
STREAM_RTMP_URL=rtmp://127.0.0.1:1935
# Plain RTMP stays on the server. OBS uses RTMPS so the stream key is not sent in the clear.
STREAM_RTMPS_URL=rtmps://swcmain183.live:1936
STREAM_RTMP_BIND=127.0.0.1
# Production media ports (UAT uses 1945 / 1946 / 8190). WebRTC listens on the same port inside
# the container because MediaMTX advertises it to browsers.
STREAM_RTMP_PORT=1935
STREAM_RTMP_ENCRYPTION=strict
STREAM_RTMP_CERT=/certs/server.crt
STREAM_RTMP_KEY=/certs/server.key
STREAM_RTMP_CERT_DIR=/opt/esabong/prod/secrets/rtmps
STREAM_RTMPS_BIND=0.0.0.0
STREAM_RTMPS_PORT=1936
STREAM_WEBRTC_PORT=8189
# Public playback and WHIP media. The host firewall must allow TCP+UDP 8189 and TCP 1936.
STREAM_WEBRTC_BIND=0.0.0.0
STREAM_STUN_URLS=[]
STREAM_TURN_URLS=[]
STREAM_TURN_SECRET=
VIDEO_SOURCE_HOSTS=[]
STREAM_TEST_SOURCE=
# ~100 viewers x 2.5 Mbps (720p) = 250 Mbps of upload: keep below the VPS port speed.
STREAM_MAX_VIEWERS=120
# Stream Operator recordings. 1 h at 720p is ~1.1 GB; the quota is per workspace and the
# free-space floor protects Postgres and backups on the shared disk.
RECORDINGS_ENABLED=true
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_MINUTES=240
RECORDING_TENANT_QUOTA_GB=40
RECORDING_MIN_FREE_GB=15

# --- Resource limits: production share of the VPS ------------------------------------------
# Budget (12 GB VPS): production ~7.25 GiB + UAT ~2.75 GiB + gateway 0.25 GiB = 10.25 GiB, leaving
# ~1.75 GiB for the OS and page cache. check-env-isolation.py adds these up.
API_CPUS=2
API_MEMORY=1536m
API_WORKERS=4
WORKER_CPUS=1
WORKER_MEMORY=768m
WORKER_CONCURRENCY=2
PG_CPUS=2
PG_MEMORY=2g
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_MAX_CONNECTIONS=200
REDIS_CPUS=1
REDIS_MEMORY=512m
REDIS_MAXMEMORY=256mb
# The origin only serves static files and proxies; TLS is the gateway's job.
CADDY_CPUS=0.5
CADDY_MEMORY=256m
# ~1 GiB + 4 MiB per peak WebRTC viewer (measured); 300 Mbit/s limits viewers before memory does.
MEDIAMTX_CPUS=2
MEDIAMTX_MEMORY=2g
# Full CPU weight under contention, normal OOM priority (UAT: 256 and 500).
CPU_SHARES=1024
OOM_SCORE_ADJ=0
PIDS_LIMIT=1024

# --- Container logs --------------------------------------------------------------------------
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
