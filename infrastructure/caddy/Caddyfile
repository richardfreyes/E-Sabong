# Edge proxy for every portal.
#
#   {$PLATFORM_HOST}              owner console + API
#   <slug>.{$BASE_DOMAIN}         tenant player portal, /admin/ portal, API
#   verified custom domains       same as tenant subdomains
#
# Certificates are issued on demand, but only for hosts the API approves via
# /api/v1/internal/tls-ask (the platform host, existing tenant subdomains and
# verified custom domains). CADDY_TLS_MODE=acme uses public CAs; `internal`
# uses Caddy's local CA for development.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/api/v1/internal/tls-ask
	}
	servers {
        strict_sni_host on
		trusted_proxies static private_ranges
	}
}

(tls-acme) {
	tls {
		on_demand
	}
}

(tls-internal) {
	tls internal {
		on_demand
	}
}

import /etc/caddy/snippets.caddy

{$PLATFORM_HOST} {
	import tls-{$CADDY_TLS_MODE}
	import security
	import access-log
	encode zstd gzip
	import api
	handle {
		root * /srv/owner
		import spa
	}
}

# Tenant subdomains and verified custom domains.
https:// {
    # Check live approval even when a certificate is already cached.
    forward_auth api:8000 {
        uri /api/v1/internal/tls-ask?domain={host}
    }
    @owner_paths path /owner /owner/* /api/v1/platform/*
    handle @owner_paths {
        respond 404
    }

	import tls-{$CADDY_TLS_MODE}
	import security
	import access-log
	encode zstd gzip
	import api
	import stream
	handle /admin {
		redir * /admin/ 308
	}
	handle_path /admin/* {
		root * /srv/admin
		import spa
	}
	handle {
		root * /srv/player
		import spa
	}
}
