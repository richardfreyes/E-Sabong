# UAT-only first deployment. No production host, catch-all, on-demand TLS, or production upstream.
# Selected by GATEWAY_MODE=uat-only; production routing requires a separate approval.
{
	email {$ACME_EMAIL}
    servers {
        strict_sni_host on
    }
    on_demand_tls {
        ask http://esabong-uat-origin:8081/tls-ask
    }
}

# Access log without credentials (the WebSocket token travels as ?token=; the UAT access
# secret only in Authorization and Cookie headers, which are deleted here; ?key= is dropped
# too, in case someone pastes a token into a URL).
(gw-log) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				delete token
				delete key
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
		}
	}
}

(gw-common) {
	# Internal API routes are for containers inside an environment only.
	handle /api/v1/internal/* {
		respond 404
	}
}

# Forward to an environment origin. Live-video playlists are streamed (LL-HLS holds requests
# open); everything else is proxied normally. While an origin restarts, retry for 10 s.
(to-origin) {
	@stream path /stream/*
	reverse_proxy @stream {args[0]}:80 {
		flush_interval -1
		lb_try_duration 10s
		lb_try_interval 250ms
	}
	reverse_proxy {args[0]}:80 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

{$UAT_HOST} {
	import gw-log
	import gw-common
	header X-Robots-Tag "noindex, nofollow, noarchive"
	handle /robots.txt {
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	# Any network can open UAT. Each app still requires its own login.
	# Drop a leftover access cookie so that token never reaches the origin.
	handle {
		request_header Cookie "esb_uat_access=[^;]*(;\s*)?" ""
		import to-origin esabong-uat-origin
	}
}

https:// {
    tls {
        on_demand
    }
    import gw-log
    import gw-common
    @owner_paths path /owner /owner/* /api/v1/platform/*
    handle @owner_paths {
        respond 404
    }
    header X-Robots-Tag "noindex, nofollow, noarchive"
    handle {
        reverse_proxy esabong-uat-origin:8081 {
            method GET
            rewrite /tls-ask?domain={host}
            header_up -Cookie
            header_up -Authorization
            @approved status 2xx
            handle_response @approved {
                import to-origin esabong-uat-origin
            }
        }
    }
}
