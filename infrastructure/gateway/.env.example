# Shared HTTPS gateway (Contabo layout). Copy to infrastructure/gateway/.env in the
# gateway checkout (/opt/esabong/gateway/infrastructure/gateway), mode 600. No real values are committed.
# Runbook: docs/deployment-contabo.md.

ACME_EMAIL=CHANGE_ME@example-domain.com
# First deployment: expose UAT only. Switch to dual only after production approval.
GATEWAY_MODE=uat-only
PROD_HOST=swcmain183.live
UAT_HOST=uat.swcmain183.live

# UAT is public: any network can open the site. Each app still requires its own login.
# The token and allowlist are no longer consulted. They stay so an existing gateway env
# file keeps passing startup checks. Generate a token with: openssl rand -hex 24
UAT_ACCESS_TOKEN=CHANGE_ME
# Unused. Leave empty. Do not add private ranges (172.16.0.0/12 and similar).
UAT_ALLOWED_IPS=

# Optional: restrict the production owner console (/owner/) and platform API to these
# addresses (space-separated). Empty = reachable from anywhere (owner credentials still required).
PROD_OWNER_ALLOWED_IPS=

HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_CPUS=1
GATEWAY_MEMORY=256m
