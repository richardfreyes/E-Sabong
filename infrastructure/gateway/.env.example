# Shared HTTPS gateway (Contabo layout). Copy to infrastructure/gateway/.env in the
# PRODUCTION checkout (/opt/esabong/prod), mode 600. No real values are committed.
# Runbook: docs/deployment-contabo.md.

ACME_EMAIL=CHANGE_ME@example-domain.com
PROD_HOST=swcmain183.live
UAT_HOST=uat.swcmain183.live

# UAT access. Allowlisted addresses get in directly; anyone else opens
#   https://uat.swcmain183.live/__uat/access
# once per browser and signs in with user "uat" and this token as password (30-day cookie).
# Share the token through a password manager, never in a link. Generate:  openssl rand -hex 24
# Must differ from every production secret; rotate it (+ gateway.sh up) to revoke all UAT access.
UAT_ACCESS_TOKEN=CHANGE_ME
# Space-separated IPs/CIDRs (office, VPN egress). Never add private ranges (172.16.0.0/12 etc.):
# Docker's userland proxy can present outside clients from those addresses.
UAT_ALLOWED_IPS=

# Optional: restrict the production owner console (/owner/) and platform API to these
# addresses (space-separated). Empty = reachable from anywhere (owner credentials still required).
PROD_OWNER_ALLOWED_IPS=

HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_CPUS=1
GATEWAY_MEMORY=256m
