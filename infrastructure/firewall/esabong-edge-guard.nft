#!/usr/sbin/nft -f
# E-Sabong edge guard — per-source connection limits for the public web ports (80/443).
#
# Its own table (inet esabong_edge_guard): it never touches the host firewall table
# (esabong-host.nft), Docker's tables or Fail2Ban's. Managed only by edge-guard.sh:
#
#   observe (default after load)  sources over a limit are counted and remembered, NOTHING is dropped
#   enforce                       the same sources get a TCP reset (edge-guard.sh enforce)
#   rollback                      nft delete table inet esabong_edge_guard (= the state before)
#
# Not loaded at boot: a reboot is also a rollback. Every limit change needs owner approval.
#
# Limits are per client IPv4 address and deliberately loose: Philippine mobile carriers put many
# players behind one carrier-grade NAT address (baseline 2026-11-20: the busiest address held
# well under 50 connections). They stop one host from opening thousands of sockets or
# reconnecting hundreds of times a second; volumetric floods need the upstream layer
# (docs/security/README.md, "Layer 1").
#
# IPv6 clients reach the gateway through docker-proxy (input hook) and are not covered here; the
# host table (esabong-host.nft) drops them by policy when loaded.

table inet esabong_edge_guard
delete table inet esabong_edge_guard

table inet esabong_edge_guard {
	# Never limited: administrator and monitoring addresses, and — once the site is proxied by an
	# upstream DDoS service — that provider's published ranges (all traffic then arrives from them).
	# The repository copy holds a documentation placeholder (RFC 5737); set real entries on the server:
	#   nft add element inet esabong_edge_guard exempt_v4 '{ 198.51.100.7/32 }'
	set exempt_v4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.255/32 }
	}

	# Open connections per source (conntrack count; entries leave when the connections close).
	set open_v4 {
		type ipv4_addr
		size 131072
		flags dynamic
	}

	# New connections per source (token bucket per address, forgotten after 2 idle minutes).
	set rate_v4 {
		type ipv4_addr
		size 131072
		flags dynamic,timeout
		timeout 2m
	}

	# Sources that went over a limit in the last 15 minutes (for review: edge-guard.sh offenders).
	set offenders_v4 {
		type ipv4_addr
		size 65536
		flags dynamic,timeout
		timeout 15m
	}

	chain forward {
		type filter hook forward priority filter + 5; policy accept;
		# Only NEW connections from the internet to the published web ports (Docker DNATs them
		# to the gateway container, so match the port the client dialled). Replies, container
		# traffic and every other port are untouched.
		iifname "eth0" ct state new meta nfproto ipv4 meta l4proto tcp ct original proto-dst { 80, 443 } jump web_new
	}

	chain web_new {
		ip saddr @exempt_v4 return
		add @open_v4 { ip saddr ct count over 2000 } counter jump over_limit comment "open connections per address"
		add @rate_v4 { ip saddr limit rate over 100/second burst 600 packets } counter jump over_limit comment "new connections per address"
	}

	chain over_limit {
		add @offenders_v4 { ip saddr }
		counter comment "over a limit (observe mode: counted only)"
		# edge-guard.sh enforce appends:  reject with tcp reset
	}
}
