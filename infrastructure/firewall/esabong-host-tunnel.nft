#!/usr/sbin/nft -f
# E-Sabong host firewall for the Cloudflare Tunnel layout (docs/security/origin-ip-change.md).
# Loaded ONLY through firewall.sh, which arms an automatic rollback first:
#
#   sudo RULES=$PWD/esabong-host-tunnel.nft ./firewall.sh check
#   sudo RULES=$PWD/esabong-host-tunnel.nft EXPECTED_SHA256=<reviewed hash> ./firewall.sh apply 5
#   (open a NEW SSH session; then) sudo ./firewall.sh confirm
#
# Policy, identical for IPv4 and IPv6:
#   - Web (80/443): nothing inbound. Visitors arrive through the outbound tunnel; the gateway
#     publishes only on 127.0.0.1. Any published port reached from eth0 is dropped unless listed.
#   - SSH (22): administrators' addresses only (admin_v4/admin_v6). Day-to-day access goes through
#     Cloudflare Access SSH over the tunnel (no inbound port); the Contabo VNC console is the
#     emergency path that no firewall rule can lock out.
#   - Streaming: WebRTC media (8189 prod, 8190 UAT) and RTMPS ingest (1936) only from the
#     broadcaster's operator addresses (operators_v4/operators_v6). Players use HLS through the
#     tunnel and never learn the origin address.
#   - Outbound: unrestricted (tunnel, ACME, Docker pulls, off-site backups).
# Replace the documentation addresses before `check`; firewall.sh refuses to apply a file whose
# hash was not reviewed.

table inet esabong_host
delete table inet esabong_host

table inet esabong_host {
	set admin_v4 {
		type ipv4_addr
		flags interval
		elements = { 203.0.113.10/32 }
	}
	set admin_v6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8::10/128 }
	}
	set operators_v4 {
		type ipv4_addr
		flags interval
		elements = { 203.0.113.20/32 }
	}
	set operators_v6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8::20/128 }
	}
	set stream_tcp {
		type inet_service
		elements = { 1936, 8189, 8190 }
	}
	set stream_udp {
		type inet_service
		elements = { 8189, 8190 }
	}

	chain input {
		type filter hook input priority filter + 10; policy drop;
		ct state established,related accept comment "keeps open SSH sessions, tunnel and all replies"
		ct state invalid drop
		iif "lo" accept comment "loopback: gateway 127.0.0.1:80/443, RTMP 1935/1945/1946, resolver"
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmp type echo-request limit rate 5/second burst 10 packets accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		icmpv6 type echo-request limit rate 5/second burst 10 packets accept
		ip saddr 10.250.250.0/29 tcp dport 22 accept comment "SSH via Cloudflare Access over the tunnel (cloudflared -> host)"
		tcp dport 22 ip saddr @admin_v4 accept comment "SSH: administrators only (emergency path)"
		tcp dport 22 ip6 saddr @admin_v6 accept
		counter comment "input dropped by policy (no public service on the host)"
	}

	chain forward {
		type filter hook forward priority filter + 10; policy accept;
		iifname "eth0" ct state new ct status dnat jump published_in
		iifname "eth0" ct state new counter drop comment "routed to a container without a published port"
	}

	chain published_in {
		meta l4proto tcp ct original proto-dst @stream_tcp ip saddr @operators_v4 accept comment "RTMPS/WebRTC: operators only"
		meta l4proto tcp ct original proto-dst @stream_tcp ip6 saddr @operators_v6 accept
		meta l4proto udp ct original proto-dst @stream_udp ip saddr @operators_v4 accept
		meta l4proto udp ct original proto-dst @stream_udp ip6 saddr @operators_v6 accept
		counter drop comment "published port not open to this source (web is tunnel-only)"
	}
}
