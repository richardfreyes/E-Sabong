# Secrets
.env
api/.env
.env.*
**/.env.*
!**/.env.example
!.env.staging.example
!.env.contabo.prod.example
!.env.contabo.uat.example

# Python
**/.venv/
**/__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
api/.media/
api/tests/.media/

# Node / Angular (see also web/.gitignore)
node_modules/

# Backups contain customer data
db/backups/*
!db/backups/.gitkeep

.DS_Store

# Off-site backup and monitoring credentials (root-only files on the server)
.offsite.env
.monitor.env
.rtmp-allowlist.env

# Playwright run artifacts (also when run from api/)
**/test-results/

# Compressed raw benchmark evidence (checksums and restore steps live in docs/benchmarks/*/)
/benchmark-archive/
