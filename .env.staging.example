# Separate local staging only. Copy OUTSIDE Git; replace every CHANGE_ME value.
# Apply docker-compose.yml + docker-compose.prod.yml + docker-compose.staging.yml.
COMPOSE_PROJECT_NAME=esabong-staging
ENVIRONMENT=production
BASE_DOMAIN=staging.esabong.test
PLATFORM_HOST=owner.staging.esabong.test
DB_NAME=esabong_staging
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_RANDOM_DISTINCT
DB_OWNER_PASSWORD=CHANGE_ME_RANDOM_DISTINCT
DB_APP_PASSWORD=CHANGE_ME_RANDOM_DISTINCT
DB_PLATFORM_PASSWORD=CHANGE_ME_RANDOM_DISTINCT
REDIS_PASSWORD=CHANGE_ME_RANDOM_DISTINCT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARACTERS
COOKIE_SECURE=true
ALLOW_TENANT_HEADER=false
PUBLIC_SCHEME=https
SMTP_HOST=smtp.invalid
SMTP_PORT=587
SMTP_USE_TLS=true
MAIL_FROM=no-reply@staging.esabong.test
ACME_EMAIL=ops@staging.esabong.test
STAGING_BACKUP_DIR=/absolute/private/staging-backups
# No external SMTP/video calls until separately configured and authorized.
API_DOCS_ENABLED=false
REDIS_MAX_CONNECTIONS=100
REDIS_PUBSUB_MAX_CONNECTIONS=1024
REDIS_POOL_TIMEOUT_SECONDS=5
