# Copy to .env and replace every value marked CHANGE_ME.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+='

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=production            # development | test | production
APP_NAME=Event Platform
LOG_LEVEL=INFO

# shared    = multi-tenant SaaS control plane
# dedicated = licensed single-tenant install (requires DEDICATED_TENANT_SLUG + LICENSE_TOKEN)
DEPLOYMENT_MODE=shared
DEDICATED_TENANT_SLUG=

# Tenants are served at <slug>.BASE_DOMAIN and at their verified custom domains.
BASE_DOMAIN=platform.example.com
PLATFORM_HOST=owner.platform.example.com
PUBLIC_SCHEME=https
# Development only: lets the SPA dev servers pick a tenant with X-Tenant-Slug.
ALLOW_TENANT_HEADER=false

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_NAME=esabong
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
# Space-separated extra databases created on first boot (e.g. "esabong_test" for CI).
DB_EXTRA_DATABASES=
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# --- Auth ------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_CHARACTERS
COOKIE_SECURE=true

# --- Licensing (Ed25519, PEM; use \n for newlines) -------------------------
# Control plane: private key signs licenses. Generate with: make license-keys
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
# Dedicated installs: signed license token issued by the control plane.
LICENSE_TOKEN=
LICENSE_HEARTBEAT_URL=https://owner.platform.example.com/api/v1/licensing/heartbeat

# --- Mail ------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@platform.example.com

# --- Billing ---------------------------------------------------------------
# ISO 4217 code; must be listed in api/app/core/money.py SUPPORTED_CURRENCIES
DEFAULT_CURRENCY=PHP
INVOICE_TAX_RATE_BPS=0

# --- Edge (Caddy) ----------------------------------------------------------
ACME_EMAIL=ops@platform.example.com
# acme     = public certificates (Let's Encrypt / ZeroSSL), on-demand for custom domains
# internal = Caddy's local CA, for development
CADDY_TLS_MODE=acme
HTTP_PORT=80
HTTPS_PORT=443
