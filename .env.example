# Copy to .env and replace every value marked CHANGE_ME.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+='

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=production            # development | test | production
APP_NAME="Event Platform"
LOG_LEVEL=INFO

# shared    = multi-tenant SaaS control plane
# dedicated = licensed single-tenant install (requires DEDICATED_TENANT_SLUG + LICENSE_TOKEN)
DEPLOYMENT_MODE=shared
DEDICATED_TENANT_SLUG=

# Tenants are served at <slug>.BASE_DOMAIN and at their verified custom domains.
BASE_DOMAIN=platform.example.com
PLATFORM_HOST=owner.platform.example.com
PUBLIC_SCHEME=https
# Development only: lets the SPA dev servers pick a tenant with X-Tenant-Slug.
ALLOW_TENANT_HEADER=false
# Tenant served at the bare BASE_DOMAIN (Contabo layout, owner console at /owner/). Empty = none.
ROOT_TENANT_SLUG=
# UAT only: synthetic data commands and test-pattern streams in production mode.
SYNTHETIC_DATA_ENABLED=false

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_NAME=esabong
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
# Space-separated extra databases created on first boot (e.g. "esabong_test" for CI).
DB_EXTRA_DATABASES=
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
# Per API worker: persistent WebSockets have a separate bounded subscription pool.
REDIS_MAX_CONNECTIONS=100
REDIS_PUBSUB_MAX_CONNECTIONS=1024
REDIS_POOL_TIMEOUT_SECONDS=5

# --- Auth ------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_CHARACTERS
COOKIE_SECURE=true

# --- Licensing (Ed25519, PEM; use \n for newlines) -------------------------
# Control plane: private key signs licenses. Generate with: make license-keys
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
# Dedicated installs: signed license token issued by the control plane.
LICENSE_TOKEN=
LICENSE_HEARTBEAT_URL=https://owner.platform.example.com/api/v1/licensing/heartbeat

# --- Mail ------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@platform.example.com

# --- Billing ---------------------------------------------------------------
# ISO 4217 code; must be listed in api/app/core/money.py SUPPORTED_CURRENCIES
DEFAULT_CURRENCY=PHP
INVOICE_TAX_RATE_BPS=0

# --- Edge (Caddy) ----------------------------------------------------------
ACME_EMAIL=ops@platform.example.com
# acme     = public certificates (Let's Encrypt / ZeroSSL), on-demand for custom domains
# internal = Caddy's local CA, for development
CADDY_TLS_MODE=acme
HTTP_PORT=80
HTTPS_PORT=443

# External video API credentials use a separate Fernet key (inject through secret manager).
# VIDEO_CREDENTIALS_KEY=
VIDEO_API_HOSTS=[]
VIDEO_MEDIA_HOSTS=[]

# Space-separated approved media/CDN HTTPS origins for browser CSP; no wildcards.
VIDEO_BROWSER_ORIGINS=

# ---- Live streaming (MediaMTX; docs/live-streaming/README.md) ----
# Opt-in: add "streaming" to COMPOSE_PROFILES to start the mediamtx container, and set the
# control-API password (24+ random characters) so the API can read status and push config.
# COMPOSE_PROFILES=streaming
# MEDIAMTX_API_PASSWORD=CHANGE_ME_RANDOM_24_PLUS
# Public IP or hostname browsers use for WebRTC media (comma-separated). Required in production.
STREAM_PUBLIC_HOSTS=127.0.0.1
# Shown to operators for OBS (the API appends /live): rtmp://stream.example.com:1935
STREAM_RTMP_URL=rtmp://localhost:1935
# STREAM_RTMPS_URL=rtmps://stream.example.com:1936
# STREAM_RTMP_ENCRYPTION=no            # optional|strict needs a certificate (see the README)
# STREAM_RTMP_PORT=1935
# STREAM_WEBRTC_PORT=8189              # UDP and TCP
# ICE servers for viewers behind strict NATs. TURN credentials are minted per playback from
# STREAM_TURN_SECRET (coturn use-auth-secret); no TURN password is ever sent to players.
STREAM_STUN_URLS=[]
STREAM_TURN_URLS=[]
# STREAM_TURN_SECRET=CHANGE_ME_RANDOM_32_PLUS
# Exact hostnames MediaMTX may pull authorized external sources from (server-side).
VIDEO_SOURCE_HOSTS=[]
# Synthetic test-pattern streams; empty = on outside production, always off in production.
# STREAM_TEST_SOURCE=

# Player sessions per stream (0 = unlimited). ~2.5 Mbps of upload per viewer at 720p.
STREAM_MAX_VIEWERS=150
# Stream Operator recordings (fMP4 in the `recordings` volume).
RECORDINGS_ENABLED=true
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_MINUTES=240
RECORDING_TENANT_QUOTA_GB=20
RECORDING_MIN_FREE_GB=5

# --- Production hardening ----------------------------------------------------
# On a production host, always apply the production overlay (no DB/Redis host ports,
# internal backend network, resource limits, required ACME/SMTP settings):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Interactive API docs are off in production unless enabled explicitly.
API_DOCS_ENABLED=
# Per-address throttles (the per-account lockout is LOGIN_MAX_ATTEMPTS).
# LOGIN_IP_MAX_FAILURES=50
# LOGIN_IP_WINDOW_SECONDS=900
# REGISTER_IP_MAX_PER_HOUR=10
# Container log rotation.
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=5

# Optional direct public gateway IPv4/IPv6 addresses for custom-domain DNS verification.
# Empty uses BASE_DOMAIN A/AAAA. Comma-separated; never use private addresses.
CUSTOM_DOMAIN_GATEWAY_IPS=
