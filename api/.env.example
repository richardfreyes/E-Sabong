# Copy to api/.env for running the API on the host against `docker compose up postgres redis`.
ENVIRONMENT=development
LOG_JSON=false
BASE_DOMAIN=localhost
PLATFORM_HOST=owner.localhost
PUBLIC_SCHEME=http
ALLOW_TENANT_HEADER=true
DATABASE_URL_APP=postgresql+asyncpg://esabong_app:dev-app@localhost:5432/esabong
DATABASE_URL_PLATFORM=postgresql+asyncpg://esabong_platform:dev-platform@localhost:5432/esabong
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://esabong_owner:dev-owner@localhost:5432/esabong
REDIS_URL=redis://:dev-redis@localhost:6379/0
CELERY_BROKER_URL=redis://:dev-redis@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:dev-redis@localhost:6379/2
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef0123456789abcdef
COOKIE_SECURE=false
MEDIA_ROOT=./.media
SMTP_HOST=localhost
SMTP_PORT=1025
