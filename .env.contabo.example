# Production .env for ONE Contabo Cloud VPS 6 (6 vCPU, 12 GB RAM, 100 GB NVMe, 300 Mbit/s).
# Copy to /opt/esabong/.env on the server (mode 600, owner = deploy user) and replace every
# CHANGE_ME. Runbook: docs/deployment-contabo.md. Never commit the real .env.
#
# Generate each secret separately:   openssl rand -base64 48 | tr -d '\n/+='
# Generate VIDEO_CREDENTIALS_KEY:     docker run --rm python:3.12-slim python -c \
#   "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Compose: always the production overlay, plus live streaming ------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=streaming

# --- Runtime -------------------------------------------------------------------------------
ENVIRONMENT=production
APP_NAME="E-Sabong"
LOG_LEVEL=INFO
DEPLOYMENT_MODE=shared
DEDICATED_TENANT_SLUG=
# Tenants are served at <slug>.BASE_DOMAIN; the owner console at PLATFORM_HOST.
BASE_DOMAIN=CHANGE_ME.example-domain.com
PLATFORM_HOST=owner.CHANGE_ME.example-domain.com
PUBLIC_SCHEME=https
ALLOW_TENANT_HEADER=false
COOKIE_SECURE=true
API_DOCS_ENABLED=

# --- PostgreSQL (internal network only; no host port in production) ------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_NAME=esabong
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
DB_EXTRA_DATABASES=

# --- Redis (internal network only) --------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_CONNECTIONS=100
REDIS_PUBSUB_MAX_CONNECTIONS=1024
REDIS_POOL_TIMEOUT_SECONDS=5

# --- Auth -----------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_CHARACTERS

# --- Licensing (only for a control plane that sells dedicated licenses) --------------------
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
LICENSE_TOKEN=
LICENSE_HEARTBEAT_URL=

# --- Mail (required in production) ---------------------------------------------------------
SMTP_HOST=CHANGE_ME.smtp-provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
MAIL_FROM=no-reply@CHANGE_ME.example-domain.com

# --- Billing ---------------------------------------------------------------------------------
DEFAULT_CURRENCY=PHP
INVOICE_TAX_RATE_BPS=0

# --- Edge (Caddy, public certificates) --------------------------------------------------------
ACME_EMAIL=CHANGE_ME@example-domain.com
CADDY_TLS_MODE=acme
HTTP_PORT=80
HTTPS_PORT=443

# --- External video provider (optional, unchanged feature) -----------------------------------
VIDEO_CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
VIDEO_API_HOSTS=[]
VIDEO_MEDIA_HOSTS=[]
VIDEO_BROWSER_ORIGINS=

# --- Live streaming (MediaMTX) ----------------------------------------------------------------
MEDIAMTX_API_PASSWORD=CHANGE_ME_RANDOM_24_PLUS
# The VPS's public IPv4 address (Contabo assigns it directly to eth0).
STREAM_PUBLIC_HOSTS=CHANGE_ME_PUBLIC_IPV4
# Shown to operators for OBS RTMP (the API appends /live). Leave empty when using WHIP only.
STREAM_RTMP_URL=rtmp://CHANGE_ME_PUBLIC_IPV4:1935
# Secure ingest: OBS 30+ WHIP over HTTPS (no extra port). To close plain RTMP entirely set
# STREAM_RTMP_BIND=127.0.0.1; to keep it, restrict 1935 to the broadcaster's IP
# (infrastructure/scripts/rtmp-allowlist.sh; runbook section 9).
STREAM_RTMP_BIND=0.0.0.0
STREAM_RTMP_PORT=1935
STREAM_RTMP_ENCRYPTION=no
STREAM_RTMPS_BIND=127.0.0.1
STREAM_WEBRTC_PORT=8189
STREAM_STUN_URLS=[]
STREAM_TURN_URLS=[]
STREAM_TURN_SECRET=
VIDEO_SOURCE_HOSTS=[]
STREAM_TEST_SOURCE=

# --- Resource limits (sum ≈ 7.5 GiB of 12 GB; the rest is OS, page cache and Docker) ---------
API_CPUS=2
API_MEMORY=1536m
WORKER_CPUS=1
WORKER_MEMORY=768m
PG_CPUS=2
PG_MEMORY=2g
REDIS_CPUS=1
REDIS_MEMORY=512m
CADDY_CPUS=1
CADDY_MEMORY=512m
# ~1 GiB + 4 MiB per peak WebRTC viewer (measured); 300 Mbit/s limits viewers before memory does.
MEDIAMTX_CPUS=2
MEDIAMTX_MEMORY=2g

# --- Container logs --------------------------------------------------------------------------
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
