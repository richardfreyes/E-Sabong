# UAT environment of the Contabo layout (same VPS as production, fully separate stack). Copy to
# /opt/esabong/uat/.env on the server (mode 600, owner = deploy user) and replace
# every CHANGE_ME. Runbook: docs/deployment-contabo.md. Never commit the real .env.
# Access is restricted at the gateway (UAT_ALLOWED_IPS / UAT_ACCESS_TOKEN in
# infrastructure/gateway/.env). Use synthetic test data only.
#
# Every secret must be generated separately and must differ from production's
# (infrastructure/scripts/check-env-isolation.py enforces it).
#
# Generate each secret separately:   openssl rand -base64 48 | tr -d '\n/+='
# Generate VIDEO_CREDENTIALS_KEY:     docker run --rm python:3.12-slim python -c \
#   "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Environment identity (do not change) ---------------------------------------------------
# Selects the Compose project esabong-uat (containers, volumes, networks) and the gateway
# network esabong-uat-gateway. The checkout directory must be named "uat".
ESB_STACK=uat
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.contabo.yml
COMPOSE_PROFILES=streaming

# --- Runtime -------------------------------------------------------------------------------
APP_NAME="E-Sabong UAT"
LOG_LEVEL=INFO
DEPLOYMENT_MODE=shared
DEDICATED_TENANT_SLUG=
# https://uat.swcmain183.live/ serves ROOT_TENANT_SLUG (player at /, admin at /admin/), the
# owner console at /owner/. UAT has no tenant subdomains or custom domains. With synthetic data:
#   docker compose run --rm api python -m app.cli demo-tenant --slug uat-demo --password '<strong>'
ENVIRONMENT=production
BASE_DOMAIN=uat.swcmain183.live
PLATFORM_HOST=uat.swcmain183.live
ROOT_TENANT_SLUG=uat-demo
PUBLIC_SCHEME=https
ALLOW_TENANT_HEADER=false
COOKIE_SECURE=true
API_DOCS_ENABLED=
# UAT runs with production safety checks (ENVIRONMENT=production) but may load synthetic data
# (demo-tenant / demo-derby) and test-pattern streams. Never copy real customer data into UAT.
SYNTHETIC_DATA_ENABLED=true

# --- PostgreSQL (internal network only; no host port in production) ------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_NAME=esabong
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
DB_EXTRA_DATABASES=

# --- Redis (internal network only) --------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_CONNECTIONS=100
REDIS_PUBSUB_MAX_CONNECTIONS=1024
REDIS_POOL_TIMEOUT_SECONDS=5

# --- Auth -----------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_CHARACTERS

# --- Licensing (only for a control plane that sells dedicated licenses) --------------------
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
LICENSE_TOKEN=
LICENSE_HEARTBEAT_URL=

# --- Mail (required in production) ---------------------------------------------------------
SMTP_HOST=CHANGE_ME.smtp-provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
MAIL_FROM=no-reply-uat@CHANGE_ME.example-domain.com

# --- Billing ---------------------------------------------------------------------------------
DEFAULT_CURRENCY=PHP
INVOICE_TAX_RATE_BPS=0

# --- Edge ------------------------------------------------------------------------------------
# TLS terminates at the shared gateway (infrastructure/gateway/.env). This stack's Caddy is a
# plain-HTTP origin without host ports; the production overlay still requires these two values.
ACME_EMAIL=CHANGE_ME@example-domain.com
CADDY_TLS_MODE=acme

# --- External video provider (optional, unchanged feature) -----------------------------------
VIDEO_CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
VIDEO_API_HOSTS=[]
VIDEO_MEDIA_HOSTS=[]
VIDEO_BROWSER_ORIGINS=

# --- Live streaming (MediaMTX) ----------------------------------------------------------------
MEDIAMTX_API_PASSWORD=CHANGE_ME_RANDOM_24_PLUS
# The VPS's public IPv4 address (Contabo assigns it directly to eth0).
STREAM_PUBLIC_HOSTS=46.250.249.61
# Shown to operators for OBS RTMP (the API appends /live). Leave empty when using WHIP only.
STREAM_RTMP_URL=rtmp://46.250.249.61:1945
# Secure ingest: OBS 30+ WHIP over HTTPS (no extra port). To close plain RTMP entirely set
# STREAM_RTMP_BIND=127.0.0.1; to keep it, restrict 1935 to the broadcaster's IP
# (infrastructure/scripts/rtmp-allowlist.sh; runbook section 9).
STREAM_RTMP_BIND=0.0.0.0
# UAT media ports (production uses 1935 / 1936 / 8189). WebRTC listens on the same port inside
# the container because MediaMTX advertises it to browsers.
STREAM_RTMP_PORT=1945
STREAM_RTMP_ENCRYPTION=no
STREAM_RTMPS_BIND=127.0.0.1
STREAM_RTMPS_PORT=1946
STREAM_WEBRTC_PORT=8190
# 127.0.0.1 keeps WebRTC media private (LL-HLS via 443 still works).
STREAM_WEBRTC_BIND=0.0.0.0
STREAM_STUN_URLS=[]
STREAM_TURN_URLS=[]
STREAM_TURN_SECRET=
VIDEO_SOURCE_HOSTS=[]
# Test-pattern streams for UAT (allowed only with SYNTHETIC_DATA_ENABLED=true).
STREAM_TEST_SOURCE=true

# --- Resource limits: UAT is capped well below production ----------------------------------
# ~2.75 GiB in total. Lower CPU weight (256 vs 1024) means production wins every CPU contention;
# OOM_SCORE_ADJ=500 means the kernel kills UAT processes first under host memory pressure.
API_CPUS=1
API_MEMORY=640m
API_WORKERS=2
WORKER_CPUS=0.5
WORKER_MEMORY=384m
WORKER_CONCURRENCY=1
PG_CPUS=1
PG_MEMORY=640m
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=384MB
PG_MAX_CONNECTIONS=60
REDIS_CPUS=0.5
REDIS_MEMORY=256m
REDIS_MAXMEMORY=128mb
CADDY_CPUS=0.25
CADDY_MEMORY=128m
MEDIAMTX_CPUS=0.5
MEDIAMTX_MEMORY=512m
CPU_SHARES=256
OOM_SCORE_ADJ=500
PIDS_LIMIT=512

# --- Container logs --------------------------------------------------------------------------
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
